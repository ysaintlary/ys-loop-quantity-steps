# Child-owned PHPStan overlay loaded after phpstan.neon.dist.
#
# WooCommerce and Barn2 stubs are not available in the quality pack.
# Ignore their class/function-not-found errors.

parameters:
  excludePaths:
    - lib

  ignoreErrors:
    -
      identifier: class.notFound
      message: '#WC_Product|Barn2\\Plugin#'
    -
      identifier: function.notFound
      message: '#is_product|wc_get_product|wc_get_quantity_input_args#'
